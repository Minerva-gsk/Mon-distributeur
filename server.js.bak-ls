'use strict';
const express = require('express');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const crypto = require('crypto');
const { promisify } = require('util');
const rateLimit = require('express-rate-limit');
const { DatabaseSync } = require('node:sqlite');
const S = require('./secu');

process.on('unhandledRejection', e => console.error('Erreur non gérée :', e));
process.on('uncaughtException', e => console.error('Exception :', e));

/* ---------- Configuration (fichier config.env facultatif) ---------- */
try {
  for (const l of fs.readFileSync('config.env', 'utf8').split('\n')) {
    const m = l.match(/^\s*([A-Z_]+)\s*=\s*(.*?)\s*$/);
    if (m && !process.env[m[1]]) process.env[m[1]] = m[2].replace(/^["']|["']$/g, '');
  }
} catch (e) {}
const PORT = Number(process.env.PORT) || 3000;
const CLE = S.chargerCle();
fs.mkdirSync('uploads', { recursive: true });
fs.mkdirSync('backups', { recursive: true });

/* ---------- E-mail (Gmail ou autre SMTP ; sinon le code s'affiche dans serveur.log) ---------- */
let transport = null;
if (process.env.SMTP_USER && process.env.SMTP_PASS) {
  try {
    transport = require('nodemailer').createTransport({
      host: process.env.SMTP_HOST || 'smtp.gmail.com', port: Number(process.env.SMTP_PORT) || 465,
      secure: (Number(process.env.SMTP_PORT) || 465) === 465,
      auth: { user: process.env.SMTP_USER, pass: process.env.SMTP_PASS }
    });
  } catch (e) { console.error('nodemailer absent : npm install nodemailer'); }
}
async function envoyerMail(to, sujet, texte) {
  if (!transport) {
    console.log('[E-MAIL NON CONFIGURÉ] à ' + to + ' | ' + sujet + ' | ' + texte);
    return false;
  }
  try {
    await transport.sendMail({ from: process.env.SMTP_FROM || process.env.SMTP_USER, to, subject: sujet, text: texte });
    return true;
  } catch (e) { console.error('Envoi e-mail échoué :', e.message); return false; }
}

/* ---------- Base de données ---------- */
const db = new DatabaseSync('musique.db');
db.exec(`
CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  nom TEXT, email TEXT UNIQUE, salt TEXT, hash TEXT, liens TEXT,
  cree TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS sessions (
  token TEXT PRIMARY KEY, user_id INTEGER,
  cree TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS releases (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  titre TEXT, artiste TEXT, genre TEXT, langue TEXT,
  date_sortie TEXT, isrc TEXT, explicite INTEGER DEFAULT 0,
  plateformes TEXT, offre TEXT, audio TEXT, pochette TEXT,
  statut TEXT DEFAULT 'En attente',
  user_id INTEGER, a_juger INTEGER DEFAULT 0,
  cree TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS likes (user_id INTEGER, release_id INTEGER, PRIMARY KEY (user_id, release_id));
CREATE TABLE IF NOT EXISTS ratings (user_id INTEGER, release_id INTEGER, note INTEGER, PRIMARY KEY (user_id, release_id));
CREATE TABLE IF NOT EXISTS comments (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  release_id INTEGER, user_id INTEGER, texte TEXT,
  cree TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS journal (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  date TEXT DEFAULT CURRENT_TIMESTAMP, user_id INTEGER, evenement TEXT, ip TEXT);
`);
for (const sql of [
  'ALTER TABLE releases ADD COLUMN user_id INTEGER',
  'ALTER TABLE releases ADD COLUMN a_juger INTEGER DEFAULT 0',
  'ALTER TABLE users ADD COLUMN liens TEXT',
  'ALTER TABLE users ADD COLUMN code_hash TEXT',
  'ALTER TABLE users ADD COLUMN code_exp INTEGER',
  'ALTER TABLE users ADD COLUMN code_essais INTEGER DEFAULT 0',
  'ALTER TABLE users ADD COLUMN reset_hash TEXT',
  'ALTER TABLE users ADD COLUMN reset_exp INTEGER',
  'ALTER TABLE users ADD COLUMN reset_essais INTEGER DEFAULT 0',
  'ALTER TABLE users ADD COLUMN totp TEXT',
  'ALTER TABLE users ADD COLUMN totp_actif INTEGER DEFAULT 0',
  'ALTER TABLE users ADD COLUMN recup TEXT',
  'ALTER TABLE users ADD COLUMN avatar TEXT'
]) { try { db.exec(sql); } catch (e) {} }
/* Les comptes créés avant la vérification e-mail sont considérés comme vérifiés (une seule fois) */
try {
  db.exec('ALTER TABLE users ADD COLUMN verifie INTEGER DEFAULT 0');
  db.exec('UPDATE users SET verifie = 1');
} catch (e) {}
db.exec(`
CREATE INDEX IF NOT EXISTS idx_sessions_user ON sessions(user_id);
CREATE INDEX IF NOT EXISTS idx_releases_user ON releases(user_id);
CREATE INDEX IF NOT EXISTS idx_comments_release ON comments(release_id);
`);

const purge = () => {
  try {
    db.exec("DELETE FROM sessions WHERE cree < datetime('now','-30 days')");
    db.exec("DELETE FROM journal WHERE date < datetime('now','-180 days')");
  } catch (e) {}
};
purge();
setInterval(purge, 3600000).unref();

/* Sauvegardes automatiques : au démarrage puis toutes les 6 h, 14 copies conservées */
function sauvegarder() {
  try {
    const d = new Date().toISOString().slice(0, 13).replace('T', '-');
    const f = path.join('backups', 'musique-' + d + 'h.db');
    if (!fs.existsSync(f)) {
      db.exec("VACUUM INTO '" + f.replace(/'/g, "''") + "'");
      try { fs.chmodSync(f, 0o600); } catch (e) {}
    }
    const vieux = fs.readdirSync('backups').filter(x => /^musique-.*\.db$/.test(x)).sort().slice(0, -14);
    vieux.forEach(x => fs.unlinkSync(path.join('backups', x)));
  } catch (e) { console.error('Sauvegarde échouée :', e.message); }
}
sauvegarder();
setInterval(sauvegarder, 6 * 3600000).unref();

/* ---------- Outils ---------- */
const CTRL = /[\u0000-\u001f\u007f]/g;
const clean = (v, max = 200) => String(v == null ? '' : v).replace(CTRL, '').trim().slice(0, max);
const bad = (res, m, code = 400, extra = {}) => res.status(code).json({ ok: false, erreur: m, ...extra });
const sha = t => crypto.createHash('sha256').update(t).digest('hex');
const hmac = t => crypto.createHmac('sha256', CLE).update(t).digest('hex');
const ah = fn => (req, res, next) => Promise.resolve(fn(req, res, next)).catch(next);
const journaliser = (req, uid, evt) => {
  try { db.prepare('INSERT INTO journal (user_id, evenement, ip) VALUES (?, ?, ?)').run(uid || null, evt, req.ip || ''); } catch (e) {}
};

/* Mots de passe : scrypt asynchrone (ne bloque plus le serveur) */
const scrypt = promisify(crypto.scrypt);
const hashPw = async (pw, salt) => (await scrypt(pw, salt, 64)).toString('hex');
async function checkPw(pw, salt, hash) {
  const a = await hashPw(pw, salt);
  return S.egal(a, hash || '');
}
const DUMMY_SALT = crypto.randomBytes(16).toString('hex');
let DUMMY_HASH = null;
async function faussePw(pw) {
  if (!DUMMY_HASH) DUMMY_HASH = await hashPw('dummy', DUMMY_SALT);
  await checkPw(pw, DUMMY_SALT, DUMMY_HASH);
  return false;
}

const FAIBLES = new Set(['12345678', '123456789', '1234567890', '87654321', 'password', 'password1',
  'motdepasse', 'motdepasse1', 'azertyuiop', 'azerty123', 'qwertyuiop', 'qwerty123',
  '11111111', '00000000', 'abcdefgh', 'iloveyou', 'musique123']);
function verifMdp(pw, email) {
  if (pw.length < 8 || pw.length > 100) return 'Mot de passe : 8 caractères minimum';
  if (FAIBLES.has(pw.toLowerCase())) return 'Mot de passe trop courant, choisis-en un autre';
  const loc = String(email || '').split('@')[0].toLowerCase();
  if (loc.length >= 4 && pw.toLowerCase().includes(loc)) return 'Le mot de passe ne doit pas contenir ton e-mail';
  return '';
}

/* Verrouillage par compte après trop d'échecs */
const echecs = new Map();
const FENETRE = 15 * 60 * 1000;
const verrouille = k => { const f = echecs.get(k); return !!f && f.n >= 8 && Date.now() - f.t < FENETRE; };
function echec(k) {
  const now = Date.now();
  if (echecs.size > 5000) echecs.clear();
  const f = echecs.get(k);
  if (!f || now - f.t > FENETRE) echecs.set(k, { n: 1, t: now });
  else { f.n++; f.t = now; }
}

/* ---------- Codes par e-mail (vérification, mot de passe oublié) ---------- */
const dernierEnvoi = new Map();
try { db.exec('ALTER TABLE users ADD COLUMN telephone TEXT'); } catch (e) {}
async function envoyerWhatsApp(tel, code) {
  const tok = process.env.WA_TOKEN, pid = process.env.WA_PHONE_ID, tpl = process.env.WA_TEMPLATE;
  if (!tok || !pid || !tpl) return false;
  try {
    const r = await fetch('https://graph.facebook.com/' + (process.env.WA_VERSION || 'v21.0') + '/' + pid + '/messages', {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + tok, 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messaging_product: 'whatsapp', to: tel, type: 'template',
        template: { name: tpl, language: { code: process.env.WA_LANG || 'fr' }, components: [
          { type: 'body', parameters: [{ type: 'text', text: code }] },
          { type: 'button', sub_type: 'url', index: '0', parameters: [{ type: 'text', text: code }] }
        ] }
      })
    });
    if (!r.ok) { console.error('[WHATSAPP] échec ' + r.status + ' ' + (await r.text()).slice(0, 250)); return false; }
    return true;
  } catch (e) { console.error('[WHATSAPP] erreur réseau'); return false; }
}
async function emettreCode(user, type) {
  const prev = dernierEnvoi.get(type + user.id) || 0;
  if (Date.now() - prev < 45000) return false;
  dernierEnvoi.set(type + user.id, Date.now());
  if (dernierEnvoi.size > 5000) dernierEnvoi.clear();
  const code = String(crypto.randomInt(0, 1000000)).padStart(6, '0');
  db.prepare('UPDATE users SET ' + type + '_hash = ?, ' + type + '_exp = ?, ' + type + '_essais = 0 WHERE id = ?')
    .run(hmac(code + ':' + user.id + ':' + type), Date.now() + 15 * 60000, user.id);
  const sujet = type === 'code' ? 'Ton code de vérification' : 'Réinitialisation du mot de passe';
  const corps = (type === 'code' ? 'Ton code de vérification : ' : 'Ton code de réinitialisation : ')
    + code + '\nIl est valable 15 minutes. Si tu n\'es pas à l\'origine de cette demande, ignore ce message.';
  const wa = db.prepare('SELECT telephone FROM users WHERE id = ?').get(user.id);
  if (!(wa && wa.telephone && await envoyerWhatsApp(wa.telephone, code))) await envoyerMail(user.email, sujet, corps);
  return true;
}
function verifierCode(uid, type, code) {
  const u = db.prepare('SELECT ' + type + '_hash AS h, ' + type + '_exp AS e, ' + type + '_essais AS n FROM users WHERE id = ?').get(uid);
  code = String(code || '').replace(/\s/g, '');
  if (!u || !u.h || !u.e || Date.now() > u.e || (u.n || 0) >= 5 || !/^\d{6}$/.test(code)) return false;
  db.prepare('UPDATE users SET ' + type + '_essais = COALESCE(' + type + '_essais, 0) + 1 WHERE id = ?').run(uid);
  if (!S.egal(hmac(code + ':' + uid + ':' + type), u.h)) return false;
  db.prepare('UPDATE users SET ' + type + '_hash = NULL, ' + type + '_exp = NULL, ' + type + '_essais = 0 WHERE id = ?').run(uid);
  return true;
}

/* ---------- Double authentification (TOTP) ---------- */
const dernierTotp = new Map();
function secondFacteurOk(uid, code) {
  const u = db.prepare('SELECT totp, recup FROM users WHERE id = ? AND totp_actif = 1').get(uid);
  if (!u) return false;
  code = String(code || '').trim();
  if (/^\d{3}\s?\d{3}$/.test(code)) {
    const secret = S.dechiffrer(CLE, u.totp);
    if (!secret) return false;
    const c = S.verifierTotp(secret, code, dernierTotp.get(uid) || 0);
    if (c === null) return false;
    dernierTotp.set(uid, c);
    return true;
  }
  const n = S.normaliserRecup(code);
  let liste = [];
  try { liste = JSON.parse(u.recup || '[]'); } catch (e) {}
  const h = hmac('recup:' + n);
  const i = liste.findIndex(x => S.egal(x, h));
  if (i < 0) return false;
  liste.splice(i, 1);
  db.prepare('UPDATE users SET recup = ? WHERE id = ?').run(JSON.stringify(liste), uid);
  return true;
}
const tickets = new Map();
function nouveauTicket(uid) {
  const t = crypto.randomBytes(24).toString('hex');
  if (tickets.size > 2000) tickets.clear();
  tickets.set(sha(t), { uid, exp: Date.now() + 5 * 60000, n: 0 });
  return t;
}

/* ---------- Sessions ---------- */
function getCookie(req, name) {
  const m = (req.headers.cookie || '').split(';').map(c => c.trim()).find(c => c.startsWith(name + '='));
  if (!m) return null;
  try { return decodeURIComponent(m.slice(name.length + 1)); } catch (e) { return null; }
}
const cookieOpts = req =>
  'HttpOnly; SameSite=Lax; Path=/' + (req.headers['x-forwarded-proto'] === 'https' ? '; Secure' : '');
function startSession(req, res, userId) {
  const token = crypto.randomBytes(32).toString('hex');
  db.prepare('INSERT INTO sessions (token, user_id) VALUES (?, ?)').run(sha(token), userId);
  db.prepare('DELETE FROM sessions WHERE user_id = ? AND token NOT IN ' +
    '(SELECT token FROM sessions WHERE user_id = ? ORDER BY cree DESC, rowid DESC LIMIT 10)').run(userId, userId);
  res.setHeader('Set-Cookie', 'sid=' + token + '; Max-Age=2592000; ' + cookieOpts(req));
}
function currentUser(req) {
  const t = getCookie(req, 'sid');
  if (!t) return null;
  return db.prepare(
    'SELECT u.id, u.nom, u.admin, u.email, u.cree, u.verifie, u.totp_actif, u.avatar FROM sessions s JOIN users u ON u.id = s.user_id ' +
    "WHERE s.token = ? AND s.cree > datetime('now','-30 days')").get(sha(t)) || null;
}
function requireSession(req, res, next) {
  const u = currentUser(req);
  if (!u) return bad(res, 'Connexion requise', 401);
  req.user = u;
  next();
}
function requireAuth(req, res, next) {
  const u = currentUser(req);
  if (!u) return bad(res, 'Connexion requise', 401);
  if (!u.verifie) return bad(res, 'Vérifie d\'abord ton adresse e-mail', 403, { verif: true });
  req.user = u;
  next();
}

/* ---------- Envoi de fichiers ---------- */
const AUDIO_EXT = ['.mp3', '.wav', '.flac', '.m4a', '.aac', '.ogg'];
const IMG_EXT = ['.jpg', '.jpeg', '.png', '.webp'];
const storage = multer.diskStorage({
  destination: 'uploads/',
  filename: (req, file, cb) =>
    cb(null, crypto.randomBytes(16).toString('hex') + path.extname(file.originalname).toLowerCase())
});
const upload = multer({
  storage,
  limits: { fileSize: 80 * 1024 * 1024, files: 2, fields: 20, fieldSize: 4096 },
  fileFilter: (req, file, cb) => {
    const ext = path.extname(file.originalname).toLowerCase();
    const ok = file.fieldname === 'audio'
      ? file.mimetype.startsWith('audio/') && AUDIO_EXT.includes(ext)
      : file.fieldname === 'pochette' && file.mimetype.startsWith('image/') && IMG_EXT.includes(ext);
    cb(null, ok);
  }
});
const rm = f => { try { fs.unlinkSync(f.path); } catch (e) {} };
function sniffOk(file, kind) {
  let b;
  try {
    const fd = fs.openSync(file.path, 'r');
    b = Buffer.alloc(16);
    fs.readSync(fd, b, 0, 16, 0);
    fs.closeSync(fd);
  } catch (e) { return false; }
  const asc = (o, n) => b.toString('latin1', o, o + n);
  if (kind === 'audio') {
    return asc(0, 3) === 'ID3' || (b[0] === 0xFF && (b[1] & 0xE0) === 0xE0)
      || asc(0, 4) === 'fLaC' || asc(0, 4) === 'OggS'
      || (asc(0, 4) === 'RIFF' && asc(8, 4) === 'WAVE') || asc(4, 4) === 'ftyp';
  }
  return (b[0] === 0xFF && b[1] === 0xD8 && b[2] === 0xFF)
    || (b[0] === 0x89 && asc(1, 3) === 'PNG')
    || (asc(0, 4) === 'RIFF' && asc(8, 4) === 'WEBP');
}

/* ---------- Limiteurs ---------- */
const mk = (windowMs, limit, erreur) => rateLimit({ windowMs, limit, message: { ok: false, erreur } });
const authLimiter = mk(15 * 60 * 1000, 20, 'Trop de tentatives, réessaie dans 15 minutes');
const registerLimiter = mk(60 * 60 * 1000, 5, 'Trop de créations de compte depuis cette connexion, réessaie plus tard');
const codeLimiter = mk(10 * 60 * 1000, 10, 'Trop de demandes de code, réessaie dans quelques minutes');
const actionLimiter = mk(60 * 1000, 30, 'Doucement, réessaie dans une minute');
const uploadLimiter = mk(60 * 60 * 1000, 20, "Trop d'envois, réessaie plus tard");
const globalLimiter = mk(60 * 1000, 300, 'Trop de requêtes, ralentis un peu');

/* ---------- Application ---------- */
const app = express();
app.disable('x-powered-by');
app.set('trust proxy', 'loopback');

app.use((req, res, next) => {
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'DENY');
  res.setHeader('Referrer-Policy', 'no-referrer');
  res.setHeader('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
  res.setHeader('Content-Security-Policy',
    "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self' 'unsafe-inline'; " +
    "script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; " +
    "base-uri 'none'; form-action 'self'; object-src 'none'");
  if (req.headers['x-forwarded-proto'] === 'https') res.setHeader('Strict-Transport-Security', 'max-age=15552000');
  if (req.path.startsWith('/api')) res.setHeader('Cache-Control', 'no-store');
  next();
});

app.use((req, res, next) => {
  if (req.method === 'GET' || req.method === 'HEAD' || req.method === 'OPTIONS') return next();
  const o = req.headers.origin;
  if (!o) return next();
  let h = '';
  try { h = new URL(o).host; } catch (e) {}
  if (h && (h === req.headers.host || h === req.headers['x-forwarded-host'] || h.endsWith('.trycloudflare.com'))) return next();
  return bad(res, 'Origine refusée', 403);
});

app.use('/api', globalLimiter);
app.use(express.json({ limit: '10kb' }));
app.use(express.static('public', { dotfiles: 'deny' }));
app.use('/uploads', requireAuth, express.static('uploads', {
  dotfiles: 'deny', index: false,
  setHeaders: res => {
    res.setHeader('Content-Security-Policy', "default-src 'none'; sandbox");
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('Cache-Control', 'private, max-age=3600');
  }
}));

/* ---------- Comptes ---------- */
app.post('/api/register', registerLimiter, authLimiter, ah(async (req, res) => {
  const b = req.body || {};
  const nom = clean(b.nom, 60);
  const email = clean(b.email, 120).toLowerCase();
  const pw = String(b.password || '');
  if (nom.length < 2) return bad(res, "Nom d'artiste : 2 à 60 caractères");
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return bad(res, 'E-mail invalide');
  const m = verifMdp(pw, email);
  if (m) return bad(res, m);
  if (db.prepare('SELECT 1 FROM users WHERE email = ?').get(email)) return bad(res, 'Cet e-mail est déjà utilisé');
  const salt = crypto.randomBytes(16).toString('hex');
  const hash = await hashPw(pw, salt);
  let id;
  try {
    id = Number(db.prepare('INSERT INTO users (nom, email, salt, hash, verifie) VALUES (?, ?, ?, ?, 0)')
      .run(nom, email, salt, hash).lastInsertRowid);
  } catch (e) { return bad(res, 'Cet e-mail est déjà utilisé'); }
  startSession(req, res, id);
  journaliser(req, id, 'inscription');
  const telRaw = String(b.telephone || '').replace(/[^0-9]/g, '');
  if (telRaw.length >= 8 && telRaw.length <= 15) db.prepare('UPDATE users SET telephone = ? WHERE id = ?').run(telRaw, id);
  await emettreCode({ id, email }, 'code');
  res.json({ ok: true, verifie: false });
}));

app.post('/api/login', authLimiter, ah(async (req, res) => {
  const b = req.body || {};
  const email = clean(b.email, 120).toLowerCase();
  const pw = String(b.password || '').slice(0, 100);
  if (verrouille(email)) return bad(res, "Trop d'échecs pour ce compte, réessaie dans 15 minutes", 429);
  const u = db.prepare('SELECT * FROM users WHERE email = ?').get(email);
  const ok = u ? await checkPw(pw, u.salt, u.hash) : await faussePw(pw);
  if (!ok) { echec(email); journaliser(req, u && u.id, 'connexion refusée'); return bad(res, 'E-mail ou mot de passe incorrect', 401); }
  if (u.totp_actif) return res.json({ ok: true, etape: '2fa', ticket: nouveauTicket(u.id) });
  echecs.delete(email);
  startSession(req, res, u.id);
  journaliser(req, u.id, 'connexion');
  res.json({ ok: true, verifie: !!u.verifie });
}));

app.post('/api/login/2fa', authLimiter, ah(async (req, res) => {
  const b = req.body || {};
  const k = sha(String(b.ticket || ''));
  const t = tickets.get(k);
  if (!t || Date.now() > t.exp) { tickets.delete(k); return bad(res, 'Session expirée, reconnecte-toi', 401); }
  if (++t.n > 5) { tickets.delete(k); return bad(res, 'Trop d\'essais, reconnecte-toi', 429); }
  if (!secondFacteurOk(t.uid, b.code)) { journaliser(req, t.uid, '2FA refusée'); return bad(res, 'Code incorrect', 401); }
  tickets.delete(k);
  const u = db.prepare('SELECT id, email, verifie FROM users WHERE id = ?').get(t.uid);
  echecs.delete(u.email);
  startSession(req, res, u.id);
  journaliser(req, u.id, 'connexion 2FA');
  res.json({ ok: true, verifie: !!u.verifie });
}));

app.post('/api/logout', (req, res) => {
  const t = getCookie(req, 'sid');
  if (t) db.prepare('DELETE FROM sessions WHERE token = ?').run(sha(t));
  res.setHeader('Set-Cookie', 'sid=; Max-Age=0; ' + cookieOpts(req));
  res.json({ ok: true });
});

app.post('/api/logout-tout', requireAuth, (req, res) => {
  db.prepare('DELETE FROM sessions WHERE user_id = ?').run(req.user.id);
  journaliser(req, req.user.id, 'déconnexion de tous les appareils');
  res.setHeader('Set-Cookie', 'sid=; Max-Age=0; ' + cookieOpts(req));
  res.json({ ok: true });
});

app.get('/api/statut', (req, res) => {
  const u = currentUser(req);
  res.json({ connecte: !!u, verifie: !!(u && u.verifie), email: u ? u.email : null });
});

app.get('/api/me', (req, res) => {
  const u = currentUser(req);
  res.json(u && u.verifie
    ? { ok: true, nom: u.nom, admin: Boolean(u.admin), email: u.email, depuis: u.cree, deuxfa: !!u.totp_actif, avatar: u.avatar || '' }
    : { ok: false });
});

/* ---------- Vérification e-mail ---------- */
app.post('/api/verifier', requireSession, codeLimiter, (req, res) => {
  if (req.user.verifie) return res.json({ ok: true });
  if (!verifierCode(req.user.id, 'code', (req.body || {}).code)) {
    journaliser(req, req.user.id, 'code e-mail refusé');
    return bad(res, 'Code incorrect ou expiré');
  }
  db.prepare('UPDATE users SET verifie = 1 WHERE id = ?').run(req.user.id);
  journaliser(req, req.user.id, 'e-mail vérifié');
  res.json({ ok: true });
});

app.post('/api/renvoyer-code', requireSession, codeLimiter, ah(async (req, res) => {
  if (req.user.verifie) return res.json({ ok: true });
  const envoye = await emettreCode(req.user, 'code');
  res.json({ ok: true, envoye, message: envoye ? 'Nouveau code envoyé' : 'Patiente environ une minute avant de redemander' });
}));

/* ---------- Mot de passe oublié ---------- */
app.post('/api/mdp-oublie', codeLimiter, ah(async (req, res) => {
  const email = clean((req.body || {}).email, 120).toLowerCase();
  const u = db.prepare('SELECT id, email FROM users WHERE email = ?').get(email);
  if (u) await emettreCode(u, 'reset');
  res.json({ ok: true, message: 'Si ce compte existe, un code vient d\'être envoyé' });
}));

app.post('/api/mdp-reset', authLimiter, ah(async (req, res) => {
  const b = req.body || {};
  const email = clean(b.email, 120).toLowerCase();
  const nouveau = String(b.nouveau || '');
  const u = db.prepare('SELECT id, email, totp_actif FROM users WHERE email = ?').get(email);
  const echecMsg = () => bad(res, 'Code incorrect ou expiré');
  if (!u) return echecMsg();
  const m = verifMdp(nouveau, email);
  if (m) return bad(res, m);
  if (!verifierCode(u.id, 'reset', b.code)) { journaliser(req, u.id, 'reset refusé'); return echecMsg(); }
  if (u.totp_actif && !secondFacteurOk(u.id, b.code2fa)) { journaliser(req, u.id, 'reset: 2FA refusée'); return bad(res, 'Code de double authentification requis', 401, { besoin2fa: true }); }
  const salt = crypto.randomBytes(16).toString('hex');
  db.prepare('UPDATE users SET salt = ?, hash = ?, verifie = 1 WHERE id = ?').run(salt, await hashPw(nouveau, salt), u.id);
  db.prepare('DELETE FROM sessions WHERE user_id = ?').run(u.id);
  echecs.delete(email);
  journaliser(req, u.id, 'mot de passe réinitialisé');
  res.json({ ok: true });
}));

/* ---------- Compte ---------- */
app.post('/api/compte/nom', requireAuth, actionLimiter, (req, res) => {
  const nom = clean((req.body || {}).nom, 60);
  if (nom.length < 2) return bad(res, "Nom d'artiste : 2 à 60 caractères");
  db.prepare('UPDATE users SET nom = ? WHERE id = ?').run(nom, req.user.id);
  res.json({ ok: true, nom });
});

app.post('/api/compte/mot-de-passe', requireAuth, authLimiter, ah(async (req, res) => {
  const b = req.body || {};
  const actuel = String(b.actuel || '').slice(0, 100);
  const nouveau = String(b.nouveau || '');
  const m = verifMdp(nouveau, req.user.email);
  if (m) return bad(res, m);
  const u = db.prepare('SELECT * FROM users WHERE id = ?').get(req.user.id);
  if (!u || !(await checkPw(actuel, u.salt, u.hash))) return bad(res, 'Mot de passe actuel incorrect', 401);
  const salt = crypto.randomBytes(16).toString('hex');
  db.prepare('UPDATE users SET salt = ?, hash = ? WHERE id = ?').run(salt, await hashPw(nouveau, salt), u.id);
  db.prepare('DELETE FROM sessions WHERE user_id = ?').run(u.id);
  startSession(req, res, u.id);
  journaliser(req, u.id, 'mot de passe changé');
  res.json({ ok: true });
}));

/* ---------- Notifications internes ---------- */
db.exec(`CREATE TABLE IF NOT EXISTS notifications (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id INTEGER NOT NULL,
  actor_id INTEGER,
  release_id INTEGER,
  type TEXT,
  texte TEXT,
  lu INTEGER DEFAULT 0,
  date TEXT DEFAULT CURRENT_TIMESTAMP
)`);
function notifier(actorId, releaseId, type) {
  const r = db.prepare('SELECT user_id, titre FROM releases WHERE id = ?').get(releaseId);
  if (!r || r.user_id === actorId) return;
  if (type !== 'comments') {
    const deja = db.prepare('SELECT 1 FROM notifications WHERE user_id = ? AND actor_id = ? AND release_id = ? AND type = ?').get(r.user_id, actorId, releaseId, type);
    if (deja) return;
  }
  const t = { ecoute: 'a écouté', like: 'a aimé', note: 'a noté', comments: 'a commenté' }[type];
  db.prepare('INSERT INTO notifications (user_id, actor_id, release_id, type, texte) VALUES (?, ?, ?, ?, ?)')
    .run(r.user_id, actorId, releaseId, type, 'Quelqu’un ' + t + ' « ' + r.titre + ' »');
}
app.use((req, res, next) => {
  const m = req.method === 'POST' && req.path.match(/^\/api\/releases\/(\d+)\/(like|note|comments)$/);
  if (m) {
    const orig = res.json.bind(res);
    res.json = body => {
      try { if (body && body.ok && req.user && (m[2] !== 'like' || body.aime)) notifier(req.user.id, Number(m[1]), m[2]); } catch (e) {}
      return orig(body);
    };
  }
  next();
});
/* ===== COMMUNAUTE ===== */
try { db.exec('ALTER TABLE users ADD COLUMN admin INTEGER DEFAULT 0'); } catch (e) {}
db.exec(`CREATE TABLE IF NOT EXISTS publications (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, texte TEXT NOT NULL, cree TEXT DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS pub_likes (user_id INTEGER, pub_id INTEGER, PRIMARY KEY (user_id, pub_id));
CREATE TABLE IF NOT EXISTS pub_comments (id INTEGER PRIMARY KEY AUTOINCREMENT, pub_id INTEGER NOT NULL, user_id INTEGER NOT NULL, texte TEXT NOT NULL, cree TEXT DEFAULT CURRENT_TIMESTAMP)`);
const comLimiter = mk(60 * 1000, 8, 'Trop de messages, patiente une minute');
const estAdmin = uid => { try { return Boolean(db.prepare('SELECT admin FROM users WHERE id = ?').get(uid)?.admin); } catch (e) { return false; } };
const nomDe = uid => db.prepare('SELECT nom FROM users WHERE id = ?').get(uid)?.nom || 'Quelqu\'un';
const comNotif = (uid, actor, txt) => db.prepare('INSERT INTO notifications (user_id, actor_id, type, texte) VALUES (?, ?, ?, ?)').run(uid, actor, 'communaute', String(txt).replace(/[<>&"]/g, '').slice(0, 160));
function comMentions(texte, auteurId, contexte) {
  const bas = texte.toLowerCase(), nom = nomDe(auteurId), vus = new Set();
  for (const u of db.prepare('SELECT id, nom FROM users').all()) {
    if (u.id === auteurId || vus.has(u.id) || !u.nom) continue;
    if (bas.includes('@' + u.nom.toLowerCase())) {
      vus.add(u.id);
      comNotif(u.id, auteurId, nom + ' t\'a mentionné ' + contexte + ' : « ' + texte.slice(0, 60) + ' »');
    }
  }
  return vus;
}
app.get('/api/com/membres', requireAuth, (req, res) => {
  res.json({ ok: true, membres: db.prepare('SELECT nom FROM users WHERE nom IS NOT NULL ORDER BY nom').all().map(u => u.nom) });
});
app.get('/api/com/fil', requireAuth, (req, res) => {
  const moi = req.user.id;
  const pubs = db.prepare('SELECT p.id, p.texte, p.cree, p.user_id, u.nom, u.admin AS adm, u.avatar AS av FROM publications p JOIN users u ON u.id = p.user_id ORDER BY p.id DESC LIMIT 50').all();
  const publications = pubs.map(p => ({
    id: p.id, texte: p.texte, cree: p.cree, auteur: p.nom, avatar: p.av || '', admin: Boolean(p.adm), a_moi: p.user_id === moi,
    likes: db.prepare('SELECT COUNT(*) AS n FROM pub_likes WHERE pub_id = ?').get(p.id).n,
    aime: Boolean(db.prepare('SELECT 1 FROM pub_likes WHERE pub_id = ? AND user_id = ?').get(p.id, moi)),
    commentaires: db.prepare('SELECT c.id, c.texte, c.user_id, u.nom, u.admin AS adm, u.avatar AS av FROM pub_comments c JOIN users u ON u.id = c.user_id WHERE c.pub_id = ? ORDER BY c.id').all(p.id)
      .map(c => ({ id: c.id, texte: c.texte, auteur: c.nom, avatar: c.av || '', admin: Boolean(c.adm), a_moi: c.user_id === moi }))
  }));
  res.json({ ok: true, moi_admin: estAdmin(moi), publications });
});
app.post('/api/com/publier', requireAuth, comLimiter, (req, res) => {
  const texte = clean((req.body || {}).texte, 500);
  if (texte.length < 1) return bad(res, 'Écris quelque chose');
  const r = db.prepare('INSERT INTO publications (user_id, texte) VALUES (?, ?)').run(req.user.id, texte);
  comMentions(texte, req.user.id, 'dans une publication');
  res.json({ ok: true, id: Number(r.lastInsertRowid) });
});
app.post('/api/com/:id/aimer', requireAuth, actionLimiter, (req, res) => {
  const id = Number(req.params.id);
  if (!db.prepare('SELECT 1 FROM publications WHERE id = ?').get(id)) return bad(res, 'Publication introuvable', 404);
  const dej = db.prepare('SELECT 1 FROM pub_likes WHERE pub_id = ? AND user_id = ?').get(id, req.user.id);
  if (dej) db.prepare('DELETE FROM pub_likes WHERE pub_id = ? AND user_id = ?').run(id, req.user.id);
  else db.prepare('INSERT INTO pub_likes (pub_id, user_id) VALUES (?, ?)').run(id, req.user.id);
  res.json({ ok: true, aime: !dej });
});
app.post('/api/com/:id/commenter', requireAuth, comLimiter, (req, res) => {
  const id = Number(req.params.id);
  const texte = clean((req.body || {}).texte, 300);
  const p = db.prepare('SELECT id, user_id FROM publications WHERE id = ?').get(id);
  if (!p) return bad(res, 'Publication introuvable', 404);
  if (texte.length < 1) return bad(res, 'Écris quelque chose');
  db.prepare('INSERT INTO pub_comments (pub_id, user_id, texte) VALUES (?, ?, ?)').run(id, req.user.id, texte);
  const cites = comMentions(texte, req.user.id, 'dans un commentaire');
  if (p.user_id !== req.user.id && !cites.has(p.user_id)) comNotif(p.user_id, req.user.id, nomDe(req.user.id) + ' a commenté ta publication');
  res.json({ ok: true });
});
app.post('/api/com/:id/supprimer', requireAuth, actionLimiter, (req, res) => {
  const id = Number(req.params.id);
  const p = db.prepare('SELECT user_id FROM publications WHERE id = ?').get(id);
  if (!p) return bad(res, 'Introuvable', 404);
  if (p.user_id !== req.user.id && !estAdmin(req.user.id)) return bad(res, 'Interdit', 403);
  db.prepare('DELETE FROM pub_likes WHERE pub_id = ?').run(id);
  db.prepare('DELETE FROM pub_comments WHERE pub_id = ?').run(id);
  db.prepare('DELETE FROM publications WHERE id = ?').run(id);
  res.json({ ok: true });
});
app.post('/api/com/commentaire/:id/supprimer', requireAuth, actionLimiter, (req, res) => {
  const id = Number(req.params.id);
  const c = db.prepare('SELECT user_id FROM pub_comments WHERE id = ?').get(id);
  if (!c) return bad(res, 'Introuvable', 404);
  if (c.user_id !== req.user.id && !estAdmin(req.user.id)) return bad(res, 'Interdit', 403);
  db.prepare('DELETE FROM pub_comments WHERE id = ?').run(id);
  res.json({ ok: true });
});
/* ===== FIN COMMUNAUTE ===== */

/* ===== ADMIN ===== */
const adminSeul = (req, res, next) => estAdmin(req.user.id) ? next() : bad(res, 'Interdit', 403);
const compte = (sql, ...p) => { try { return db.prepare(sql).get(...p).n; } catch (e) { return 0; } };
app.get('/api/admin/resume', requireAuth, adminSeul, (req, res) => {
  const utilisateurs = db.prepare('SELECT id, nom, email, verifie, admin, cree FROM users ORDER BY id DESC LIMIT 100').all()
    .map(u => ({ id: u.id, nom: u.nom, email: u.email, verifie: Boolean(u.verifie), admin: Boolean(u.admin), sorties: compte('SELECT COUNT(*) AS n FROM releases WHERE user_id = ?', u.id) }));
  res.json({ ok: true, utilisateurs, stats: {
    comptes: compte('SELECT COUNT(*) AS n FROM users'), verifies: compte('SELECT COUNT(*) AS n FROM users WHERE verifie = 1'),
    sorties: compte('SELECT COUNT(*) AS n FROM releases'), publications: compte('SELECT COUNT(*) AS n FROM publications'),
    paiements: compte('SELECT COUNT(*) AS n FROM paiements') } });
});
app.post('/api/admin/utilisateur/:id/valider', requireAuth, adminSeul, actionLimiter, (req, res) => {
  const r = db.prepare('UPDATE users SET verifie = 1, code_hash = NULL, code_exp = NULL, code_essais = 0 WHERE id = ?').run(Number(req.params.id));
  if (!r.changes) return bad(res, 'Compte introuvable', 404);
  res.json({ ok: true });
});
app.post('/api/admin/utilisateur/:id/mdp', requireAuth, adminSeul, actionLimiter, async (req, res) => {
  try {
    const id = Number(req.params.id);
    if (!db.prepare('SELECT 1 FROM users WHERE id = ?').get(id)) return bad(res, 'Compte introuvable', 404);
    const mdp = crypto.randomBytes(6).toString('base64url');
    const salt = crypto.randomBytes(16).toString('hex');
    const hash = await hashPw(mdp, salt);
    db.prepare('UPDATE users SET salt = ?, hash = ?, verifie = 1, reset_hash = NULL, reset_exp = NULL, reset_essais = 0 WHERE id = ?').run(salt, hash, id);
    if (id !== req.user.id) { try { db.prepare('DELETE FROM sessions WHERE user_id = ?').run(id); } catch (e) {} }
    res.json({ ok: true, mdp });
  } catch (e) { bad(res, 'Erreur serveur', 500); }
});
/* ===== FIN ADMIN ===== */

// ===== MESSAGERIE =====
db.exec("CREATE TABLE IF NOT EXISTS messages (id INTEGER PRIMARY KEY AUTOINCREMENT, de INTEGER NOT NULL, a INTEGER NOT NULL, texte TEXT NOT NULL, cree INTEGER NOT NULL, lu INTEGER NOT NULL DEFAULT 0)");
db.exec("CREATE INDEX IF NOT EXISTS idx_msg_a ON messages(a, lu)");
const msgLimiter = mk(60 * 1000, 40, 'Trop de messages, patiente un instant.');
function msgMoi(req) { return Number(req.user.id); }
app.get('/api/msg/contacts', requireAuth, (req, res) => {
  const me = msgMoi(req);
  const rows = db.prepare(`SELECT u.id, u.nom, u.avatar, u.admin,
    (SELECT m.texte FROM messages m WHERE (m.de = u.id AND m.a = ?) OR (m.de = ? AND m.a = u.id) ORDER BY m.id DESC LIMIT 1) AS dernier,
    (SELECT m.cree FROM messages m WHERE (m.de = u.id AND m.a = ?) OR (m.de = ? AND m.a = u.id) ORDER BY m.id DESC LIMIT 1) AS quand,
    (SELECT COUNT(*) FROM messages m WHERE m.de = u.id AND m.a = ? AND m.lu = 0) AS nonlus
    FROM users u WHERE u.id != ?`).all(me, me, me, me, me, me);
  const contacts = rows.map(r => ({ id: Number(r.id), nom: r.nom, avatar: r.avatar || '', admin: Boolean(r.admin), dernier: r.dernier || '', quand: r.quand || 0, nonlus: Number(r.nonlus) || 0 }));
  contacts.sort((x, y) => (y.quand - x.quand) || String(x.nom).localeCompare(String(y.nom)));
  res.json({ contacts });
});
app.get('/api/msg/conv/:id', requireAuth, (req, res) => {
  const me = msgMoi(req), autre = parseInt(req.params.id, 10);
  if (!autre || autre === me) return bad(res, 'Introuvable', 404);
  const apres = parseInt(req.query.apres, 10) || 0;
  let rows;
  if (apres) rows = db.prepare('SELECT * FROM messages WHERE id > ? AND ((de = ? AND a = ?) OR (de = ? AND a = ?)) ORDER BY id LIMIT 200').all(apres, me, autre, autre, me);
  else rows = db.prepare('SELECT * FROM messages WHERE (de = ? AND a = ?) OR (de = ? AND a = ?) ORDER BY id DESC LIMIT 60').all(me, autre, autre, me).reverse();
  { const _r = db.prepare('UPDATE messages SET lu = 1 WHERE de = ? AND a = ? AND lu = 0').run(autre, me); if (_r && _r.changes) msPousse(autre, 'lu', {}); }
  res.json({ messages: rows.map(m => ({ id: Number(m.id), texte: m.texte, cree: Number(m.cree), moi: Number(m.de) === me, lu: Boolean(m.lu) })) });
});
app.post('/api/msg/envoyer', requireAuth, msgLimiter, (req, res) => {
  const me = msgMoi(req);
  const a = parseInt(req.body && req.body.a, 10);
  const t = clean(req.body && req.body.texte, 1000);
  if (!a || a === me || !t) return bad(res, 'Message invalide', 400);
  if (!db.prepare('SELECT id FROM users WHERE id = ?').get(a)) return bad(res, 'Destinataire introuvable', 404);
  const r = db.prepare('INSERT INTO messages (de, a, texte, cree) VALUES (?, ?, ?, ?)').run(me, a, t, Date.now()); msPousse(a, 'msg', { de: me });
  res.json({ ok: true, id: Number(r.lastInsertRowid) });
});
app.get('/api/msg/non-lus', requireAuth, (req, res) => {
  const r = db.prepare('SELECT COUNT(*) AS n FROM messages WHERE a = ? AND lu = 0').get(msgMoi(req));
  res.json({ n: Number(r.n) || 0 });
});
// ===== FIN MESSAGERIE =====

// ===== STORIES =====
const stFs = require('fs'), stPath = require('path'), stCrypto = require('crypto');
const stDir = stPath.join(__dirname, 'uploads');
try { stFs.mkdirSync(stDir, { recursive: true }); } catch (e) {}
db.exec("CREATE TABLE IF NOT EXISTS stories (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, texte TEXT NOT NULL DEFAULT '', image TEXT NOT NULL DEFAULT '', cree INTEGER NOT NULL)");
db.exec("CREATE TABLE IF NOT EXISTS story_vues (story_id INTEGER NOT NULL, user_id INTEGER NOT NULL, PRIMARY KEY (story_id, user_id))");
const ST_DUREE = 24 * 60 * 60 * 1000;
const stMulter = require('multer');
const stUp = stMulter({ storage: stMulter.memoryStorage(), limits: { fileSize: 6 * 1024 * 1024, files: 1 } });
const stLimiter = mk(60 * 60 * 1000, 15, 'Trop de stories, réessaie plus tard.');
function stType(b) {
  if (!b || b.length < 12) return '';
  if (b[0] === 0xFF && b[1] === 0xD8 && b[2] === 0xFF) return '.jpg';
  if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4E && b[3] === 0x47) return '.png';
  if (b.toString('latin1', 0, 4) === 'RIFF' && b.toString('latin1', 8, 12) === 'WEBP') return '.webp';
  return '';
}
function stEfface(image) {
  if (image && image.startsWith('/uploads/st-')) { try { stFs.unlinkSync(stPath.join(stDir, stPath.basename(image))); } catch (e) {} }
}
app.get('/api/stories', requireAuth, (req, res) => {
  const me = msgMoi(req), depuis = Date.now() - ST_DUREE;
  const rows = db.prepare(`SELECT s.id, s.user_id, s.texte, s.image, s.cree, u.nom, u.avatar, u.admin,
    (SELECT COUNT(*) FROM story_vues v WHERE v.story_id = s.id) AS vues,
    (SELECT COUNT(*) FROM story_vues v WHERE v.story_id = s.id AND v.user_id = ?) AS vu
    FROM stories s JOIN users u ON u.id = s.user_id WHERE s.cree > ? ORDER BY s.id`).all(me, depuis);
  const g = new Map();
  rows.forEach(r => {
    const k = Number(r.user_id);
    if (!g.has(k)) g.set(k, { user_id: k, nom: r.nom, avatar: r.avatar || '', admin: Boolean(r.admin), a_moi: k === me, stories: [] });
    g.get(k).stories.push({ id: Number(r.id), texte: r.texte, image: r.image, cree: Number(r.cree), vues: k === me ? Number(r.vues) : 0, vu: Number(r.vu) > 0 || k === me });
  });
  const liste = [...g.values()].map(x => Object.assign({}, x, { tout_vu: x.stories.every(s => s.vu) }));
  liste.sort((a, b) => (Number(b.a_moi) - Number(a.a_moi)) || (Number(a.tout_vu) - Number(b.tout_vu)) || (b.stories[b.stories.length - 1].cree - a.stories[a.stories.length - 1].cree));
  res.json({ stories: liste });
});
app.post('/api/stories', requireAuth, stLimiter, (req, res) => {
  stUp.single('photo')(req, res, err => {
    if (err) return bad(res, 'Image trop lourde (6 Mo max)', 400);
    const me = msgMoi(req), texte = clean(req.body && req.body.texte, 200) || '';
    let image = '';
    if (req.file) {
      const ext = stType(req.file.buffer);
      if (!ext) return bad(res, 'Format image non accepté', 400);
      const nom = 'st-' + stCrypto.randomBytes(16).toString('hex') + ext;
      stFs.writeFileSync(stPath.join(stDir, nom), req.file.buffer);
      image = '/uploads/' + nom;
    }
    if (!image && !texte) return bad(res, 'Story vide', 400);
    const r = db.prepare('INSERT INTO stories (user_id, texte, image, cree) VALUES (?, ?, ?, ?)').run(me, texte, image, Date.now());
    res.json({ ok: true, id: Number(r.lastInsertRowid) });
  });
});
app.post('/api/stories/:id/vu', requireAuth, (req, res) => {
  const me = msgMoi(req), id = parseInt(req.params.id, 10);
  const s = db.prepare('SELECT user_id FROM stories WHERE id = ?').get(id);
  if (s && Number(s.user_id) !== me) db.prepare('INSERT OR IGNORE INTO story_vues (story_id, user_id) VALUES (?, ?)').run(id, me);
  res.json({ ok: true });
});
app.post('/api/stories/:id/supprimer', requireAuth, (req, res) => {
  const me = msgMoi(req), id = parseInt(req.params.id, 10);
  const s = db.prepare('SELECT user_id, image FROM stories WHERE id = ?').get(id);
  if (!s) return bad(res, 'Introuvable', 404);
  const admin = typeof estAdmin === 'function' && estAdmin(me);
  if (Number(s.user_id) !== me && !admin) return bad(res, 'Interdit', 403);
  stEfface(s.image);
  db.prepare('DELETE FROM story_vues WHERE story_id = ?').run(id);
  db.prepare('DELETE FROM stories WHERE id = ?').run(id);
  res.json({ ok: true });
});
const stNettoie = setInterval(() => {
  try {
    const old = db.prepare('SELECT id, image FROM stories WHERE cree < ?').all(Date.now() - ST_DUREE - 3600000);
    old.forEach(o => { stEfface(o.image); db.prepare('DELETE FROM story_vues WHERE story_id = ?').run(o.id); db.prepare('DELETE FROM stories WHERE id = ?').run(o.id); });
  } catch (e) {}
}, 60 * 60 * 1000);
if (stNettoie.unref) stNettoie.unref();
// ===== FIN STORIES =====

// ===== MSG TEMPS REEL =====
const msFlux = new Map(), msVu = new Map();
function msPousse(uid, type, data) {
  const s = msFlux.get(Number(uid)); if (!s) return;
  const p = 'event: ' + type + '\ndata: ' + JSON.stringify(data || {}) + '\n\n';
  s.forEach(r => { try { r.write(p); } catch (e) {} });
}
app.get('/api/msg/flux', requireAuth, (req, res) => {
  const me = msgMoi(req);
  res.writeHead(200, { 'Content-Type': 'text/event-stream', 'Cache-Control': 'no-cache', 'Connection': 'keep-alive', 'X-Accel-Buffering': 'no' });
  res.write('retry: 3000\n\n');
  if (!msFlux.has(me)) msFlux.set(me, new Set());
  msFlux.get(me).add(res);
  msVu.set(me, Date.now());
  const ping = setInterval(() => { try { res.write(': ping\n\n'); } catch (e) {} }, 25000);
  req.on('close', () => {
    clearInterval(ping);
    const s = msFlux.get(me);
    if (s) { s.delete(res); if (!s.size) msFlux.delete(me); }
    msVu.set(me, Date.now());
  });
});
