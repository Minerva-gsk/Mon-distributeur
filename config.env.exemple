# Copie ce fichier en config.env pour que les codes arrivent par e-mail (Gmail).
# Il faut un "mot de passe d'application" Google (compte Google > Sécurité > Validation en 2 étapes > Mots de passe des applications).
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=mot-de-passe-application-16-caracteres
SMTP_FROM="Distributeur Musique <ton.adresse@gmail.com>"
